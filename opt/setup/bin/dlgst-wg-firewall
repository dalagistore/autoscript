#!/usr/bin/env bash
set -Eeuo pipefail

case "${1:-}" in
  up)
    subnet="${2:?subnet wajib}"
    iface="${3:?interface wajib}"
    python3 - "${subnet}" "${iface}" <<'PY'
import ipaddress
import re
import sys
ipaddress.ip_network(sys.argv[1], strict=True)
if not re.fullmatch(r'[A-Za-z0-9_.:-]{1,64}', sys.argv[2]):
    raise SystemExit('Interface tidak valid')
PY
    # The table is dedicated to this feature. Replace stale state left by an
    # unclean shutdown so wg-quick can start after reboot/recovery.
    if nft list table ip dlgst_wireguard >/dev/null 2>&1; then
      nft delete table ip dlgst_wireguard
    fi
    nft -f - <<NFT
table ip dlgst_wireguard {
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    ip saddr ${subnet} oifname "${iface}" masquerade
  }
}
NFT
    ;;
  down)
    if nft list table ip dlgst_wireguard >/dev/null 2>&1; then
      nft delete table ip dlgst_wireguard
    fi
    ;;
  *)
    echo "Usage: $0 {up SUBNET IFACE|down}" >&2
    exit 2
    ;;
esac
